# Copy to .env.local and fill in. Never commit .env.local.
# Every value here is intentionally EMPTY. check:no-secrets fails on non-empty values.
#
# This product needs no credentials and stores no secrets. It reads a local git repository,
# spawns a local Python interpreter, and optionally serves a local web page. If you find
# yourself adding an API key here, the feature you are building has probably left the
# deterministic path -- see docs/adr/0002-python-engine-boundary.md.

# Runtime mode: development | production
PRODUCT_ENV=development

# Where the SQLite CACHE lives. This is never the system of record -- audit/ in the repository
# is. See docs/adr/0005-git-as-system-of-record.md.
PRODUCT_DATA_DIR=.data

# Log verbosity on stderr: debug | info | warn | error
LOG_LEVEL=info

# Optional: the Python interpreter for the deterministic engine. Overrides engine.python in
# product.config.json.
# PYTHON=python

# Optional: narrow the permission ceiling of `biasledger mcp serve`. Comma-separated, from
# fs:read < net:fetch < env:read < fs:write < proc:spawn < secrets:read. Defaults to the union
# of what the registered tools declare.
# PRODUCT_MCP_PERMISSIONS=fs:read,proc:spawn

# Optional: the URL the Electron shell loads. Defaults to http://localhost:3000.
# PRODUCT_WEB_URL=http://localhost:3000

# Optional: telemetry. Off unless this is exactly "true", and nothing about the audit product
# requires it -- the product is local-first and the evidence never leaves the repository.
TELEMETRY_ENABLED=false
